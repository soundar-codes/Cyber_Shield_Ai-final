{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/cybershield-feedback", "destination": "/feedback.html" },
      { "source": "/cybershield-feedback/", "destination": "/feedback.html" },
      { "source": "/feedback", "destination": "/feedback.html" }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
